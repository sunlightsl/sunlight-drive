# ---------------------------------------------------------------
# Sunlight 云盘 · 配置示例
# ---------------------------------------------------------------
# 复制成 .env 再改：
#     cp .env.example .env
# 本地开发直接 `node dev.js` 即可 —— 不建 .env 也能跑，
# 打开页面注册第一个账号，它会成为站长。
#
# 这个文件是给人看的模板，可以进版本库；
# 真正的 .env 绝不能进版本库（.gitignore 已经挡住）。
#
# 每一行都可以整条删掉 —— 删掉即用括号里的默认值。
# ---------------------------------------------------------------

# ---------- 站点 ----------
BRAND=Sunlight云盘
PORT=3000
# 时区。影响日志时间和页面上「N 分钟前」之类的相对时间。
#
# 实测行为（Node 22）：Linux / macOS 上**改完立即生效**，可以写在这里。
# Windows 不认这个环境变量 —— 那边要改系统时区，改这里没用。
# 更稳妥的做法是写进 systemd 单元（Environment=TZ=Asia/Shanghai），
# 那样进程一启动就是对的时区，不依赖应用自己设置。
TZ=Asia/Shanghai

# ---------- 数据目录 ----------
# drive.json（文件树与账号）+ secrets.json（加密的凭证）+ .master.key 都在这里。
# 想把数据放到别的盘或独立挂载点，改成绝对路径 —— 比搬整个项目省事。
#
# 留空 = 用项目下的 ./data/。
# 注意：改成一个新目录等于**换了一个空库**，旧数据还在原处，记得一起拷过去。
DRIVE_DATA_DIR=

# 只换 drive.json 的位置（一般用不到，端到端测试会把它指到临时文件上）
DRIVE_DATA_FILE=

# ---------- 注册 ----------
# open   = 允许注册（空库里第一个注册的账号会成为站长）
# closed = 只允许已有账号登录
#
# ⚠️ 两个变量是有联动的，配错会把站点锁死：
#     REGISTRATION=closed 且 SITE_PASSWORD 为空
#     → 启动后一个账号都没有，注册又被关掉，**没人能登录**。
#   安全起见这里保持 open；部署完成后按需改成 closed
#   （改之前确认你已经有一个能登录的站长账号）。
REGISTRATION=open

# ---------- 认证 ----------
# 首个账号的初始口令。库里一旦有了账号，这个值就退休了 ——
# 之后登录比的是用户记录里的哈希，它不再参与。
#
# 两条路，二选一：
#   a) 留空  → 启动后打开页面注册第一个账号，它自动成为站长。
#              省事，但注册必须开着（见上面的 REGISTRATION）。
#   b) 填上  → 启动时就用它建出站长（账号名取 ADMIN_USERNAME，默认 sunlight），
#              之后注册的人一律是普通成员。**这是确定性做法，推荐公网用**。
SITE_PASSWORD=
# 走上面 (b) 时用的账号名。留空则用 sunlight。
ADMIN_USERNAME=
# 首个账号的 2FA 密钥。可以留空，之后在页面上扫码绑定。
# 也可以用自带脚本生成：node setup-2fa.js
TOTP_SECRET=
# 临时关掉动态码（手机丢失 / 本地调试）。设 1 = 只校验密码。
# 仅限临时使用：置 1 期间第二因素失效，公网实例不应保持该状态。
TOTP_DISABLED=0

# 会话与限流（可选调参）
TOKEN_TTL=3600
AUTH_CHALLENGE_TTL=120
MAX_ATTEMPTS=10
ATTEMPT_WINDOW=900

# ---------- 分享 ----------
SHARE_TTL=7200
SHARE_MAX_ATTEMPTS=10
SHARE_ATTEMPT_WINDOW=900
# 生成分享链接用的站点地址。不填就用请求里的 Host，
# 本地会生成 127.0.0.1 的链接，部署后应填真实地址。
SHARE_BASE_URL=

# ---------- 网络 ----------
# 只有当服务躲在「会覆写 X-Forwarded-For」的反向代理后面时才设为 1。
# 设为 1 而没有反代 = 任何人都能伪造这个头来绕过限流。
TRUST_PROXY=0

# ---------- 对象存储 ----------
# 两种填法，二选一：
#   a) 填在这里（简单，但密钥在文件里）
#   b) 留空，部署后用站长账号在「头像菜单 → 配置」里填
#      （密钥会加密落盘，接口只回脱敏值）
OSS_REGION=oss-cn-hangzhou
OSS_KEY_ID=
OSS_KEY_SECRET=
OSS_BUCKET=
# 上传落点前缀。给这个子账号的写权限就锁在这个前缀里。
OSS_UPLOAD_PREFIX=drive
# 下载链接有效期（秒）
SIGN_TTL=300

# ---------- 上传与配额 ----------
# 单文件上限（MB）。Nginx 的 client_max_body_size 要和它对齐。
MAX_UPLOAD_MB=2048
# 每个用「平台存储」的用户的默认配额（GB）。0 = 不限。
QUOTA_GB=1

# ---------- 主密钥（进阶，通常不用设）----------
# 加密 OSS 凭证与分享密码原文用的主密钥。
#
# ⚠️ 这一项是**口令**语义（内容会被哈希成定长密钥），
#    而 data/.master.key 里存的是**原始 32 字节**。
#    所以把 .master.key 的文件内容填到这里，永远解不开已有的密文。
#
# 默认留空即可 —— 程序会自动生成并读取 data/.master.key。
# 只有在「密钥不该和应用放在同一块盘」的场景下才设置它，
# 且必须在第一次写入凭证之前就设置好。
# MASTER_KEY=
